{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "jsx": "react-jsx",
    "lib": ["es2022", "dom"],
    "types": ["node", "vite/client"]
  },
  "include": ["backend/src", "backend/test", "frontend/src", "frontend/test-setup.js"]
}
